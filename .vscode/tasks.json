{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build Flappy Bird",
            "type": "process",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=gnu++20",
                "-g",
                "-Wall",
                "-DPDC_WIDE",
                "-DPDC_FORCE_UTF8",
                "-IC:/msys64/ucrt64/include/pdcurses",
                "${workspaceFolder}/main.cpp",
                "-o",
                "${workspaceFolder}/flappy.exe",
                "-LC:/msys64/ucrt64/lib",
                "-lpdcurses"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
